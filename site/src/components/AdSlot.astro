---
/**
 * 详情页文末广告位（AdSense 展示广告）。
 *
 * 摆放原则（AdSense 政策 + 阅读体验）：
 *  1. 只在正文结束之后出现，绝不插在标题、导航、下载/版本按钮附近；
 *  2. 明确标注「广告 / Advertisement」，不伪装成站内内容或推荐；
 *  3. 不遮挡、不浮动、不自动撑开遮挡正文，颜色与字重刻意压低；
 *  4. 列表页、首页、404 页一律不出现。
 *
 * 未配置广告单元 ID 时整个组件零输出（连容器都不渲染）。
 */
import { ADSENSE_CLIENT, ADSENSE_DETAIL_SLOT, adsDetailEnabled } from "../lib/adsense";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const zh = locale === "zh";
const label = zh ? "广告" : "Advertisement";
---

{adsDetailEnabled && (
  <aside class="ad-slot" aria-label={label}>
    <div class="ad-slot-label">{label}</div>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={ADSENSE_DETAIL_SLOT}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
)}

<style>
  .ad-slot {
    margin: var(--s10) 0 0;
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }
  .ad-slot-label {
    margin-bottom: var(--s3);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-4);
  }
  .ad-slot :global(ins.adsbygoogle) {
    display: block;
    min-height: 0;
  }
</style>
