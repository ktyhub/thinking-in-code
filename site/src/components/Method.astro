---
import Shell from "../layouts/Shell.astro";
import { t, localePath, type Locale } from "../lib/i18n";
import { stats } from "../lib/registry";
import { num } from "../lib/format";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = stats();

const steps = [
  { k: t(locale, "method.step1.title"), v: t(locale, "method.step1.body") },
  { k: t(locale, "method.step2.title"), v: t(locale, "method.step2.body") },
  { k: t(locale, "method.step3.title"), v: t(locale, "method.step3.body") },
  { k: t(locale, "method.step4.title"), v: t(locale, "method.step4.body") },
];
---

<Shell
  locale={locale}
  title={t(locale, "method.title")}
  description={t(locale, "method.lead")}
  active="method"
>
  <div class="wrap" style="padding-top:var(--s10);max-width:860px">
    <p class="eyebrow">Method</p>
    <h1 style="font-size:clamp(1.9rem,4vw,2.6rem);letter-spacing:-0.04em;margin-top:var(--s4)">{t(locale, "method.title")}</h1>
    <p class="hero-lead" style="margin-top:var(--s3);font-size:1rem">{t(locale, "method.lead")}</p>

    <div class="pgrid" style="grid-template-columns:1fr 1fr;margin-top:var(--s10)">
      {steps.map((st, i) => (
        <div class="pcard" style="min-height:0;padding:var(--s5)">
          <span class="mono" style="font-size:11px;letter-spacing:0.12em;color:var(--ink-4)">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span style="font-size:16px;font-weight:600;letter-spacing:-0.02em;margin-top:2px">{st.k}</span>
          <span style="font-size:13.5px;color:var(--ink-3);line-height:1.6;margin-top:4px">{st.v}</span>
        </div>
      ))}
    </div>

    <section style="margin-top:var(--s12);border-top:1px solid var(--ink);padding-top:var(--s5)">
      <h2 style="font-size:1.2rem;letter-spacing:-0.02em">{t(locale, "method.principle.title")}</h2>
      <p style="margin-top:var(--s3);color:var(--ink-2);max-width:66ch;line-height:1.7">
        {t(locale, "method.principle.body")}
      </p>
    </section>

    <section style="margin-top:var(--s10);display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1px;background:var(--line);border:1px solid var(--line)">
      <div style="background:var(--paper);padding:var(--s4)">
        <div class="mono" style="font-size:22px;font-variant-numeric:tabular-nums">{num(s.projects)}</div>
        <div style="font-size:12px;color:var(--ink-3);margin-top:2px">{t(locale, "stat.projects")}</div>
      </div>
      <div style="background:var(--paper);padding:var(--s4)">
        <div class="mono" style="font-size:22px;font-variant-numeric:tabular-nums">{num(s.releases)}</div>
        <div style="font-size:12px;color:var(--ink-3);margin-top:2px">{t(locale, "stat.releases")}</div>
      </div>
      <div style="background:var(--paper);padding:var(--s4)">
        <div class="mono" style="font-size:22px;font-variant-numeric:tabular-nums">{s.latestDate || "—"}</div>
        <div style="font-size:12px;color:var(--ink-3);margin-top:2px">{t(locale, "stat.sync")}</div>
      </div>
    </section>

    <p style="margin-top:var(--s8)">
      <a class="btn btn--solid" href={localePath(locale, "/releases")}>{t(locale, "action.all")} →</a>
    </p>
  </div>
</Shell>
