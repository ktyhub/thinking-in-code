---
/**
 * 技术笔记布局（/zh/chapter_*）。版本发布走 ReleaseDetail，
 * 这里只服务长文阅读：侧边章节导航 + 正文。
 */
import Shell from "./Shell.astro";
import { getNavGroups, breadcrumbs } from "../lib/nav";

interface Props {
  frontmatter: { title?: string; description?: string };
  urlPath: string;
  /**
   * 旧站语言占位页（docs/en、docs/ar… 各一篇）只是为了让老链接不 404，
   * 内容是路径拼出来的标题 + 空正文，属于典型薄内容，必须 noindex。
   */
  noindex?: boolean;
}

const { frontmatter, urlPath, noindex = false } = Astro.props;
const groups = getNavGroups();
const topKey = urlPath.split("/").filter(Boolean)[1] ?? "";
const group = groups.find((g) => g.key === topKey);
const crumbs = breadcrumbs(urlPath.replace(/\/$/, ""));
const isCurrent = (href: string) => urlPath === href || urlPath === `${href}/`;
---

<Shell locale="zh" title={frontmatter.title} description={frontmatter.description} noindex={noindex}>
  <div class="wrap doc-shell">
    <aside class="doc-side">
      <h3>{group?.title ?? "技术笔记"}</h3>
      <ul>
        {group?.items.map((it) => (
          <li>
            <a
              href={it.href}
              class:list={[`lv${Math.min(it.level, 2)}`]}
              aria-current={isCurrent(it.href) ? "page" : undefined}
              title={it.title}
            >
              {it.title}
            </a>
          </li>
        ))}
      </ul>
      <h3>导航</h3>
      <ul>
        <li><a href="/zh/chapters/">全部章节</a></li>
        <li><a href="/zh/releases/">版本发布</a></li>
        <li><a href="/">英文站</a></li>
      </ul>
    </aside>

    <article>
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="sep">/</span>}
            {c.href ? <a href={c.href}>{c.title}</a> : <span>{c.title}</span>}
          </>
        ))}
      </nav>
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</Shell>
