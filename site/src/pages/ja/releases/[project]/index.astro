---
import ProjectPage from "../../../../components/ProjectPage.astro";
import { allProjects } from "../../../../lib/registry";

/** 项目版本历史页：每种语言都生成，URL 前缀与语言一一对应 */
export function getStaticPaths() {
  return allProjects()
    .filter((p) => p.count > 0)
    .map((p) => ({ params: { project: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
---

<ProjectPage locale="ja" slug={slug} />
