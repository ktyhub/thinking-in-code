---
import Shell from "../../layouts/Shell.astro";
import { getNavGroups } from "../../lib/nav";

const groups = getNavGroups().slice().sort((a, b) => {
  const ac = a.key.startsWith("chapter") ? 0 : 1;
  const bc = b.key.startsWith("chapter") ? 0 : 1;
  if (ac !== bc) return ac - bc;
  return b.items.length - a.items.length;
});
const total = groups.reduce((n, g) => n + g.items.length, 0);
const pretty = (k: string) => k.replace(/^chapter_/, "").replace(/_/g, " ").toUpperCase();

const DESC: Record<string, string> = {
  chapter_mysql: "事务、锁、MVCC、Redo/Undo、Binlog 与分布式事务",
  chapter_kafka: "高性能高可用设计、Producer/Sender、IO 线程模型",
  chapter_dubbo: "SPI 扩展、服务暴露与引用、集群容错与负载均衡",
  chapter_zookeeper: "客户端会话、Watcher、ZAB 协议与 Leader 选举",
  chapter_kubernetes: "ApiServer 主流程、控制器、调度与网络模型",
  chapter_netty: "EventLoopGroup、Bootstrap 与 Reactor 线程模型",
  chapter_springboot: "run 方法、SPI 扫描、Environment 与容器刷新",
  chapter_spring_ai: "AI 顾问 Advisor、MCP 协议与模型上下文实践",
};
---

<Shell locale="zh" title="技术笔记" description="中间件、云原生、Spring 全家桶的源码级解析，按技术领域归档。">
  <div class="wrap" style="padding-top:var(--s10)">
    <p class="eyebrow">Technical notes</p>
    <h1 style="font-size:clamp(1.9rem,4vw,2.6rem);letter-spacing:-0.04em;margin-top:var(--s4)">源码级技术解析</h1>
    <p class="hero-lead" style="margin-top:var(--s3);font-size:1rem">
      {total} 篇文章，按技术领域归档。版本发布请前往
      <a href="/zh/releases/" style="color:var(--accent-ink);text-decoration:underline">版本发布</a>。
    </p>

    <div class="pgrid" style="margin-top:var(--s10)">
      {groups.map((g) => (
        <a class="pcard" href={`/zh/${g.key}/`}>
          <span class="pcard-name">{g.title || pretty(g.key)}</span>
          <span class="pcard-repo">{DESC[g.key] ?? ""}</span>
          <span class="pcard-meta">
            <span><b>{g.items.length}</b> 篇</span>
            <span class="mono" style="font-size:11px">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</Shell>
