---
import fs from "node:fs";
import path from "node:path";
import DocLayout from "../../../layouts/DocLayout.astro";
import { getNavGroups } from "../../../lib/nav";

/**
 * 很多章节目录没有 index.md（旧站靠 mkdocs 的目录索引），
 * 直接访问 /zh/chapter_xxx/ 会 404。这里为这些目录生成聚合页。
 */
export async function getStaticPaths() {
  const docsZh = path.resolve(process.cwd(), "../docs/zh");
  const groups = getNavGroups();
  const paths: { params: { group: string }; props: { group: string } }[] = [];
  for (const g of groups) {
    const hasIndex = fs.existsSync(path.join(docsZh, g.key, "index.md"));
    if (!hasIndex) paths.push({ params: { group: g.key }, props: { group: g.key } });
  }
  return paths;
}

const { group } = Astro.props;
const groups = getNavGroups();
const current = groups.find((g) => g.key === group);
const items = current?.items ?? [];
const title = current?.title || group.replace(/^chapter_/, "").replace(/_/g, " ");
---

<DocLayout frontmatter={{ title }} urlPath={`/zh/${group}/`}>
  <h1>{title}</h1>
  <p class="muted" style="margin:var(--s3) 0 var(--s6);font-size:14px">
    共 {items.length} 篇文章，按顺序阅读效果最佳。
  </p>
  <div class="feed">
    {items.filter((it) => it.level === 0).map((it, i) => (
      <a class="rrow" href={it.href} style="grid-template-columns:44px minmax(0,1fr)">
        <span class="rrow-date">{String(i + 1).padStart(2, "0")}</span>
        <span class="rrow-ver" style="font-weight:500;font-size:15px">{it.title}</span>
      </a>
    ))}
  </div>
  {items.some((it) => it.level > 0) && (
    <div style="margin-top:var(--s8)">
      <h2 style="font-size:1.1rem;margin-bottom:var(--s3)">子专题</h2>
      <div class="feed">
        {items.filter((it) => it.level > 0).map((it) => (
          <a class="rrow" href={it.href} style="grid-template-columns:minmax(0,1fr)">
            <span style="font-size:14px;color:var(--ink-2)">{it.title}</span>
          </a>
        ))}
      </div>
    </div>
  )}
</DocLayout>
