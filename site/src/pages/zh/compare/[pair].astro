---
import ComparePage from "../../../components/ComparePage.astro";
import { allPairs } from "../../../lib/catalog";

export function getStaticPaths() {
  return allPairs().map((p) => ({ params: { pair: p.slug } }));
}

const { pair } = Astro.params;
---

<ComparePage locale="zh" pairSlug={pair!} />
