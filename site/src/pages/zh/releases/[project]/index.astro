---
import ProjectPage from "../../../../components/ProjectPage.astro";
import { allProjects } from "../../../../lib/registry";

export function getStaticPaths() {
  return allProjects()
    .filter((p) => p.count > 0)
    .map((p) => ({ params: { project: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
---

<ProjectPage locale="zh" slug={slug} />
