---
import TopicPage from "../../../components/TopicPage.astro";
import { publicTopics } from "../../../lib/catalog";
import { localeInBuild } from "../../../lib/i18n";

export function getStaticPaths() {
  if (!localeInBuild("zh")) return [];
  return publicTopics().map((t) => ({ params: { topic: t.slug } }));
}

const { topic } = Astro.params;
---

<TopicPage locale="zh" slug={topic!} />
