---
import ProjectPage from "../../../../components/ProjectPage.astro";
import { allProjects } from "../../../../lib/registry";

/**
 * 兼容旧站地址：/zh/release_note/{project}/ 仍然可访问，
 * canonical 指向新的 /zh/releases/{project}/，避免重复内容。
 */
export function getStaticPaths() {
  return allProjects()
    .filter((p) => p.count > 0)
    .map((p) => ({ params: { project: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
---

<ProjectPage locale="zh" slug={slug} canonicalPath={`/zh/releases/${slug}/`} />
