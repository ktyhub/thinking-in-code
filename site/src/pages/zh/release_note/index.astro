---
import { getEntry, render } from "astro:content";
import DocLayout from "../../../layouts/DocLayout.astro";
import { getReleaseProjects } from "../../../lib/nav";

const entry = await getEntry("releaseNoteIndex", "release_note");
const { Content } = await render(entry);
const projects = getReleaseProjects();
---

<DocLayout frontmatter={{ title: "📰 RELEASE NOTE — 开源项目版本发布追踪" }} urlPath="/zh/release_note/" showReleaseSidebar>
  <Content />
  <h2>🗂️ 全部追踪项目（{projects.length}）</h2>
  <p>点击项目查看该项目的全部版本发布记录，每日自动采集翻译更新。</p>
  <div class="card-grid" style="margin-top: var(--sp-6);">
    {projects.map((p) => (
      <a class="topic-card" href={p.href}>
        <div class="name">📦 {p.name}</div>
        <div class="desc">{p.count} 个版本记录</div>
      </a>
    ))}
  </div>
</DocLayout>
