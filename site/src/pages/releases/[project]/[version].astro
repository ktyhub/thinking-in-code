---
import { getCollection, getEntry, render } from "astro:content";
import ReleaseDetail from "../../../components/ReleaseDetail.astro";
import { allReleases, getReleaseByKey } from "../../../lib/registry";

export async function getStaticPaths() {
  // 以内容集合为准，避免索引与文件短暂不一致时生成空页
  const entries = await getCollection("releasesEn");
  const ids = new Set(entries.map((e) => e.id));
  return allReleases()
    .filter((r) => r.hasEn && r.entryEn && ids.has(r.entryEn))
    .map((r) => ({
      params: { project: r.projectSlug, version: r.versionSlug },
      props: { key: r.key },
    }));
}

const { key } = Astro.props;
const release = getReleaseByKey(key)!;
const entry = await getEntry("releasesEn", release.entryEn!);
if (!entry) {
  throw new Error(`releasesEn 缺少条目：${release.entryEn}`);
}
const { Content, headings } = await render(entry);

const altHref = release.hasZh && release.entryZh ? `/zh/release_note/${release.entryZh}` : null;
---

<ReleaseDetail release={release} locale="en" headings={headings} altHref={altHref}>
  <Content />
</ReleaseDetail>
