---
import ProjectPage from "../../../components/ProjectPage.astro";
import { allProjects } from "../../../lib/registry";
import { localeInBuild } from "../../../lib/i18n";

export function getStaticPaths() {
  if (!localeInBuild("en")) return [];
  return allProjects()
    .filter((p) => p.count > 0)
    .map((p) => ({ params: { project: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
---

<ProjectPage locale="en" slug={slug} />
