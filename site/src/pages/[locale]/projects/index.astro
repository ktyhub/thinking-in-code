---
/** 各语言的 Projects 索引页 */
import ProjectsIndex from "../../../components/ProjectsIndex.astro";
import { EXTRA_LOCALES, type Locale } from "../../../lib/i18n";

export function getStaticPaths() {
  return EXTRA_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---

<ProjectsIndex locale={locale} />
