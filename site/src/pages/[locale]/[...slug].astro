---
import { getCollection, render } from "astro:content";
import DocLayout from "../../layouts/DocLayout.astro";

/** 其他语言的占位页，保持旧站 hreflang URL 不 404 */
export async function getStaticPaths() {
  const entries = await getCollection("locales");
  return entries.map((entry) => {
    const slug = entry.id.replace(/\/index$/, "");
    return { params: { locale: slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fm = (entry.data ?? {}) as { title?: string; description?: string };
let title = fm.title;
if (!title) {
  const m = (entry.body ?? "").match(/^#\s+(.+)$/m);
  title = m ? m[1].trim() : entry.id;
}
const lang = entry.id.split("/")[0];
// 这些页面只为保持老链接不 404：docs/en、docs/ar、docs/ko、docs/ru… 每篇
// 只有路径拼成的标题和空正文，属于薄内容，参与索引只会稀释整站质量。
// 因此统一传 noindex —— 可访问、可分享，但不进 sitemap、不参与排名。
---
<DocLayout frontmatter={{ title: `${title} (${lang})` }} urlPath={Astro.url.pathname} noindex>
  <Content />
</DocLayout>
