---
/** 各语言的 Releases 索引页（带筛选，状态同步 URL） */
import ReleasesIndex from "../../../components/ReleasesIndex.astro";
import { EXTRA_LOCALES, type Locale } from "../../../lib/i18n";

export function getStaticPaths() {
  return EXTRA_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---

<ReleasesIndex locale={locale} />
