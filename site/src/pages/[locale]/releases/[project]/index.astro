---
/** 各语言的项目版本历史页：语言 × 项目 的笛卡尔积，页数增长最快的一类 */
import ProjectPage from "../../../../components/ProjectPage.astro";
import { allProjects } from "../../../../lib/registry";
import { EXTRA_LOCALES, type Locale } from "../../../../lib/i18n";

export function getStaticPaths() {
  const projects = allProjects().filter((p) => p.count > 0);
  return EXTRA_LOCALES.flatMap((locale) =>
    projects.map((p) => ({ params: { locale, project: p.slug }, props: { locale, slug: p.slug } })),
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
---

<ProjectPage locale={locale} slug={slug} />
