---
/**
 * 所有非英语语言的首页。
 *
 * 以前 ja/de/fr/es/pt 各有一份手写目录，扩到 249 种语言就是复制 249 次。
 * 现在统一由这里按 EXTRA_LOCALES 生成，新增语言只需要改 i18n.ts 的 LOCALES
 * 或构建时传 SITE_LOCALES。
 */
import Home from "../../components/Home.astro";
import { EXTRA_LOCALES, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return EXTRA_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---

<Home locale={locale} />
