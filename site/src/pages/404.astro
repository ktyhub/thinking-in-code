---
import Shell from "../layouts/Shell.astro";
---

<Shell locale="en" title="Page not found" noindex>
  <div class="wrap" style="padding:14vh 0;max-width:560px">
    <p class="eyebrow">404</p>
    <h1 style="font-size:clamp(1.9rem,4vw,2.6rem);letter-spacing:-0.04em;margin-top:var(--s4)">Page not found</h1>
    <p style="margin-top:var(--s4);color:var(--ink-2);line-height:1.7">
      The page you are looking for has moved or never existed. Try the release index, or search with ⌘K.
    </p>
    <p style="margin-top:var(--s8);display:flex;gap:var(--s3);flex-wrap:wrap">
      <a class="btn btn--solid" href="/releases">Browse releases</a>
      <a class="btn btn--ghost" href="/">Home</a>
      <a class="btn btn--ghost" href="/zh/releases/">中文</a>
    </p>
  </div>
</Shell>
