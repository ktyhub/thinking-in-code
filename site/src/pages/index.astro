---
import Base from "../layouts/Base.astro";
import { getNavGroups } from "../lib/nav";
import { getLatestReleases } from "../lib/releases";

const groups = getNavGroups();
const latest = getLatestReleases(8);

const topics = [
  { icon: "🗄️", name: "MySQL", href: "/zh/chapter_mysql/", desc: "事务、锁、MVCC、Redo/Undo、Binlog 与分布式事务源码解析" },
  { icon: "📨", name: "Kafka", href: "/zh/chapter_kafka/", desc: "高性能高可用设计、Producer/Sender、IO 线程模型" },
  { icon: "🐘", name: "Dubbo", href: "/zh/chapter_dubbo/", desc: "SPI 扩展、服务暴露、注册发现与集群容错原理" },
  { icon: "🐝", name: "Zookeeper", href: "/zh/chapter_zookeeper/", desc: "客户端、Watcher、选举算法与 Leader 选举源码" },
  { icon: "☸️", name: "Kubernetes", href: "/zh/chapter_kubernetes/", desc: "ApiServer 主流程、配置初始化与 API 服务器链" },
  { icon: "🌐", name: "Netty", href: "/zh/chapter_netty/", desc: "EventLoopGroup、BootStrap 与 Reactor 线程模型" },
  { icon: "🍃", name: "Spring Boot", href: "/zh/chapter_springboot/", desc: "run 方法、SPI 扫描、Environment 与容器初始化" },
  { icon: "🤖", name: "Spring AI / MCP", href: "/zh/chapter_spring_ai/", desc: "AI 顾问 Advisor、MCP 协议与模型上下文实践" },
];
---

<Base>
  <section class="hero">
    <div class="hero-badge">🚀 开源技术版本订阅平台</div>
    <h1>追踪 GitHub 项目发布<br /><span class="grad">洞察新技术应用</span></h1>
    <p class="sub">
      NextStack 每日自动追踪 Kafka、Dubbo、Zookeeper、Kubernetes、Spring 等主流开源项目的版本发布，
      提供中文深度解读与源码级技术解析，帮你第一时间把握技术演进方向。
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="/zh/release_note/">📰 浏览版本发布</a>
      <a class="btn btn-ghost" href="#topics">📚 开始阅读源码解析</a>
    </div>
  </section>

  <div class="stats-strip">
    <div class="stat-card"><div class="num">3200+</div><div class="lbl">深度技术文章</div></div>
    <div class="stat-card"><div class="num">200+</div><div class="lbl">追踪的开源项目</div></div>
    <div class="stat-card"><div class="num">每日</div><div class="lbl">自动采集翻译更新</div></div>
  </div>

  <section class="section" id="topics">
    <h2 class="section-title">📚 覆盖的技术领域</h2>
    <p class="section-sub">从中间件到云原生，从框架设计到 AI 工程化，源码级的深度解析</p>
    <div class="card-grid">
      {topics.map((t) => (
        <a class="topic-card" href={t.href}>
          <div class="icon">{t.icon}</div>
          <div class="name">{t.name}</div>
          <div class="desc">{t.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">🆕 最新版本发布</h2>
    <p class="section-sub">每日自动采集翻译的 GitHub 项目 Release Notes</p>
    <div class="release-list">
      {latest.map((r) => (
        <a class="release-item" href={r.href}>
          <span class="tag">{r.project}</span>
          <span class="t">{r.title}</span>
          <span class="d">{r.date}</span>
        </a>
      ))}
    </div>
    <p style="margin-top: var(--sp-4); text-align: center;">
      <a class="btn btn-ghost" href="/zh/release_note/">查看全部 {groups.length ? "" : ""}→</a>
    </p>
  </section>

  <section class="download-banner">
    <div class="download-card">
      <div style="display:flex; align-items:center; gap: var(--sp-6); flex:1; min-width: 280px;">
        <img src="/img/stags-tracker-icon.png" alt="Stags Tracker 应用图标" loading="lazy" />
        <div>
          <h3>📦 Stags Tracker — Mac 桌面端</h3>
          <p>GitHub 订阅追踪桌面应用：仓库订阅、Release/Issue/PR 追踪、更新提醒、一键翻译</p>
        </div>
      </div>
      <a class="btn btn-primary" href="/zh/downloads/">免费下载 →</a>
    </div>
  </section>
</Base>
